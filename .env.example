# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase (Project Settings -> API). SERVER ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx   # older projects: the service_role key, in SUPABASE_SERVICE_ROLE_KEY (also accepted)

# AI (https://aistudio.google.com -> Get API key). Model: pick a Flash / Flash-Lite model shown as free in AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: how many AI requests run at once (lower it if you hit rate limits)
AI_CONCURRENCY=1
